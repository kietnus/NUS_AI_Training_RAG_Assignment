# Copy to .env (project root) and adjust if needed. All values below are the defaults.

DATABASE_URL=postgresql://nusaskify:nusaskify@localhost:5433/nusaskify
OLLAMA_HOST=http://localhost:11434

# Embedding model: chunks AND questions use this same model.
EMBEDDING_MODEL=qwen3-embedding:0.6b
# Must equal the model's output dimension (qwen3-embedding:0.6b = 1024).
# Changing it requires resetting the database: docker compose down -v && docker compose up -d
EMBEDDING_DIM=1024
# Task instruction added to queries only (Qwen3-Embedding format). Empty = no instruction.
QUERY_INSTRUCTION="Given a question about internal company policies, retrieve the policy passages that answer the question"

CHAT_MODEL=qwen3:4b-instruct
LLM_TEMPERATURE=0.0
LLM_NUM_CTX=8192

# Retrieval
DEFAULT_TOP_K=5
# Best chunk score below this -> "not enough information" without calling the LLM.
# Calibrate with /api/search (compare scores of answerable vs. unanswerable questions).
MIN_SCORE=0.40

# Semantic chunking
SEMANTIC_THRESHOLD_TYPE=percentile
SEMANTIC_BREAKPOINT_PERCENTILE=25
SEMANTIC_SIMILARITY_THRESHOLD=0.55
SEMANTIC_BUFFER_SIZE=1
MAX_CHUNK_CHARS=1200
MIN_CHUNK_CHARS=150

# Structure-based chunking
STRUCTURE_MAX_CHUNK_CHARS=1200

MAX_UPLOAD_MB=20
